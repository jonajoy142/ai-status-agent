# App
APP_NAME="SprintPilot.AI"
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_PATH=data/sprintpilot.db
DATABASE_URL=postgresql://user:password@localhost:5432/sprintpilot
DATABASE_POOL_SIZE=10

# AI
LLM_PROVIDER=demo
LLM_MODEL=llama3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# Vector Store
VECTOR_PROVIDER=local
VECTOR_STORE=chromadb
VECTOR_DB_PATH=vector_db
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings
EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Jira Connector
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ

# GitHub Connector
GITHUB_TOKEN=
GITHUB_REPO=org/repo
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# Slack Connector
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_IDS=C01234,C05678

# Docs Connectors
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=
NOTION_TOKEN=
LINEAR_API_KEY=

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sprintpilot

# Payments
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox

# Security
CONNECTOR_CONFIG_ENCRYPTION_KEY=
JWT_SECRET=
