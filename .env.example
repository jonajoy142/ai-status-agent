APP_NAME="SprintPilot.AI"
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000

# Demo-safe default. Use openai or ollama when configured.
LLM_PROVIDER=demo
LLM_MODEL=llama3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Demo-safe default. Use chroma locally after running ingestion.
VECTOR_PROVIDER=local
VECTOR_DB_PATH=vector_db
EMBEDDING_MODEL=nomic-embed-text

# Future connector credentials. Keep secrets out of source control.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=
NOTION_TOKEN=
LINEAR_API_KEY=

ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
