# App
APP_NAME="SprintPilot.AI"
APP_ENV=development
ENVIRONMENT=local
SECRET_KEY=your-secret-key-min-64-chars
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_PATH=data/sprintpilot.db
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sprintpilot
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-jwt-secret-min-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/oauth/github/callback

# Email verification
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
FROM_EMAIL=noreply@sprintpilotai.com

# AI
LLM_PROVIDER=demo
LLM_MODEL=llama3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# Vector Store
VECTOR_PROVIDER=local
# local | chromadb | qdrant | weaviate
VECTOR_BACKEND=local
VECTOR_STORE=chromadb
VECTOR_DB_PATH=vector_db
CHROMA_HOST=localhost
CHROMA_PORT=8001
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings
EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Jira Connector
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ

# GitHub Connector
GITHUB_TOKEN=
GITHUB_REPO=org/repo
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_PRIVATE_KEY=

# Slack Connector
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_IDS=C01234,C05678

# Docs Connectors
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=
NOTION_TOKEN=
LINEAR_API_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sprintpilot

# Payments
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox

# Security
CONNECTOR_CONFIG_ENCRYPTION_KEY=
